# Copy this file to .env (git-ignored) and fill in what you use, then restart the dev server.
# Variables already set in the real environment override this file.

# Sentry agent tracing. Spans are sent only when this is set.
# Sentry: Project Settings > Client Keys (DSN).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1

# Gemma through Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# GEMMA_MODEL=gemma3:4b
# GEMMA_TIMEOUT_MS=180000

# MongoDB Atlas (optional). Note: this stores the uploaded photo with each RoomGraph.
# MONGODB_URI=
# MONGODB_DB=reality_compiler

# API port (the Vite dev server proxies /api to 8787)
# PORT=8787
