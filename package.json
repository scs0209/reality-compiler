{
  "name": "reality-compiler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reality Compiler — Compiles room photos into executable RoomGraph JSON with epistemic uncertainty (Observed vs Inferred), spatial relations, top-down 2D simulation, and moving What-If verification.",
  "scripts": {
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "^8.40.0",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "mongodb": "^6.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
